# Groq API key — get a free one at:
#   https://console.groq.com/keys
# Free tier on llama-3.3-70b-versatile is generous (very fast inference).
# Note: Groq is text-only; the backend extracts PDF text via pypdf before
# sending it to the model.
GROQ_API_KEY=gsk_your-groq-key-here

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://ccms_admin:ccms_secret@localhost:5432/ccms_ai

# Storage
PDF_STORAGE_PATH=./storage/pdfs

# JWT
JWT_SECRET=change-me-in-production-please-please
JWT_EXPIRY_MINUTES=720

# Groq model — llama-3.3-70b-versatile is the recommended legal-extraction
# model (128k context window, free tier).
# Alternatives: llama-3.1-8b-instant (faster, smaller), mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Max characters of PDF text we send to Groq in a single request.
#   * Free tier: 6,000 tokens/minute on llama-3.3-70b — keep this around
#     18,000 chars (~4,500 tokens). Larger requests get the connection
#     dropped by Groq's edge with no error body.
#   * Developer tier: 60,000 TPM — you can raise this to ~200,000.
# When the judgment is longer than the budget, the backend keeps the
# opening pages (parties, prayer) AND the closing pages (operative
# directions) and drops the middle judicial reasoning — so the action
# plan still extracts cleanly.
GROQ_MAX_INPUT_CHARS=18000

# Max output tokens for the JSON action plan. JSON rarely exceeds
# ~1,500 tokens; 2048 leaves comfortable headroom.
GROQ_MAX_OUTPUT_TOKENS=2048
